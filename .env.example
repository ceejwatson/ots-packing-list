# Server-side stock audit. Without these values the endpoint returns 503.
AUDIT_API_SECRET=
# Upstash-compatible Redis REST endpoint and token. Shared across instances.
AUDIT_REDIS_REST_URL=
AUDIT_REDIS_REST_TOKEN=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=

# Optional aggregate growth measurement. Separate storage credentials are recommended.
# Keep disabled until the Redis service and privacy disclosure have been reviewed.
GROWTH_MEASUREMENT_ENABLED=false
GROWTH_REDIS_REST_URL=
GROWTH_REDIS_REST_TOKEN=
# Independent random secrets; never use NEXT_PUBLIC_ prefixes. Minimum admin length: 24.
GROWTH_ADMIN_PASSWORD=
GROWTH_RATE_SECRET=
GROWTH_SITE_ORIGIN=https://otspackinglist.com

# Optional AI reviews. No provider calls occur without explicit enablement.
GROWTH_AI_ENABLED=false
OPENAI_API_KEY=
# A Responses API model supporting structured outputs; select before enabling.
OPENAI_GROWTH_MODEL=
# Daily production schedule remains inactive unless enabled and authenticated.
GROWTH_SCHEDULED_REVIEW_ENABLED=false
CRON_SECRET=
